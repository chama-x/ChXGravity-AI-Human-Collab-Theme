{
  "editor.accessibilitySupport": "off",
  "antigravity-plus.autoApprove.enabled": true,

  "workbench.sideBar.location": "right",
  "workbench.activityBar.location": "top",
  "editor.minimap.enabled": false,
  "workbench.panel.alignment": "center",

  "terminal.integrated.enablePersistentSessions": false,
  "debug.internalConsoleOptions": "neverOpen",
  "debug.openDebug": "neverOpen",
  "terminal.integrated.fontSize": 11,

  "workbench.colorCustomizations": {
    "editor.background": "#141414",
    "editor.foreground": "#888888",
    "sideBar.background": "#141414",
    "activityBar.background": "#141414",
    "statusBar.background": "#141414",
    "statusBarItem.remoteBackground": "#141414",
    "statusBarItem.remoteForeground": "#6c7086",
    "titleBar.activeBackground": "#141414",
    "titleBar.inactiveBackground": "#141414",
    "panel.background": "#141414",
    "breadcrumb.background": "#141414",
    "editorWidget.background": "#1a1a1a",
    "editorGroupHeader.tabsBackground": "#141414",
    "tab.activeBackground": "#1a1a1a",
    "tab.inactiveBackground": "#141414",

    "sideBar.border": "#0000",
    "activityBar.border": "#0000",
    "statusBar.border": "#0000",
    "editorGroup.border": "#0000",
    "panel.border": "#0000",
    "tab.border": "#0000",
    "editor.lineHighlightBorder": "#0000",
    "window.activeBorder": "#0000",
    "window.inactiveBorder": "#0000",
    "widget.shadow": "#0000",
    "scrollbar.shadow": "#0000",

    "focusBorder": "#ffffff22",

    "editorCursor.foreground": "#a78bfa",
    "terminalCursor.foreground": "#a78bfa",

    "editor.selectionBackground": "#ffffff20",
    "editor.selectionForeground": "#141414",
    "editor.selectionHighlightBackground": "#ffffff10",

    "editorLineNumber.foreground": "#444444",
    "editorLineNumber.activeForeground": "#888888",

    "scrollbarSlider.background": "#ffffff08",
    "scrollbarSlider.hoverBackground": "#ffffff15",
    "scrollbarSlider.activeBackground": "#ffffff25",

    "button.background": "#2a2a2a",
    "button.foreground": "#cdd6f4",
    "button.hoverBackground": "#3a3a3a",
    
    "button.secondaryBackground": "#1e1e1e",
    "button.secondaryForeground": "#a6adc8",
    "button.secondaryHoverBackground": "#2a2a2a",

    "textLink.foreground": "#cdd6f4",
    "textLink.activeForeground": "#ffffff",

    "activityBarBadge.background": "#c4f042",
    "activityBarBadge.foreground": "#141414",
    "badge.background": "#c4f042",
    "badge.foreground": "#141414",
    
    "progressBar.background": "#a78bfa",

    "tab.activeBorderTop": "#0000",
    "tab.activeBorder": "#0000",
    "panelTitle.activeBorder": "#444444",

    "editorSuggestWidget.highlightForeground": "#a78bfa",
    "list.highlightForeground": "#cdd6f4",
    "list.activeSelectionBackground": "#2a2a2a",
    "list.inactiveSelectionBackground": "#1e1e1e",
    "list.hoverBackground": "#1a1a1a",

    "editor.findMatchBackground": "#c4f04244",
    "editor.findMatchHighlightBackground": "#c4f04222",
    "editorBracketHighlight.foreground1": "#888888",
    "editorBracketHighlight.foreground2": "#666666",
    "editorBracketHighlight.foreground3": "#444444"
  },

  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": [
          "keyword", "keyword.control", "keyword.operator", "keyword.other", 
          "storage", "storage.type", "storage.modifier", 
          "variable.language", "constant.language"
        ],
        "settings": {
          "foreground": "#5a5a5a",
          "fontStyle": "italic"
        }
      },
      {
        "scope": [
          "entity.name", "entity.name.function", "entity.name.type", "entity.name.class", 
          "support.function", "support.class", "entity.name.tag", "entity.name.tag.css",
          "entity.other.attribute-name.class", "entity.other.attribute-name.class.css", 
          "entity.other.attribute-name.id", "entity.other.attribute-name.id.css", 
          "entity.other.attribute-name.pseudo-class", "entity.other.attribute-name.pseudo-class.css",
          "entity.other.attribute-name.pseudo-element", "entity.other.attribute-name.pseudo-element.css",
          "support.type", "support.type.python", "support.type.primitive", "support.type.primitive.ts"
        ],
        "settings": {
          "foreground": "#909090",
          "fontStyle": "bold italic"
        }
      },
      {
        "scope": [
          "variable", "variable.other", "variable.parameter", "variable.other.readwrite",
          "variable.other.readwrite.js", "variable.other.readwrite.ts",
          "variable.other.object", "variable.other.object.js", "variable.other.object.ts",
          "variable.other.constant", "variable.other.constant.js", "variable.other.constant.ts",
          "support.type.object.dom", "support.variable.dom",
          "meta", "punctuation", "constant", "support", "support.variable",
          "support.constant.property-value", "support.constant.property-value.css",
          "support.constant.font-name", "support.constant.font-name.css",
          "support.constant.media", "support.constant.media.css"
        ],
        "settings": {
          "foreground": "#6c6c6c",
          "fontStyle": "italic"
        }
      },
      {
        "scope": [
          "support.type.property-name", "meta.object-literal.key",
          "entity.other.attribute-name", "variable.other.property",
          "string.json", "meta.structure.dictionary.json string.quoted.double.json", 
          "meta.structure.dictionary.value.json string.quoted.double.json"
        ],
        "settings": {
          "foreground": "#7d7d7d",
          "fontStyle": "italic"
        }
      },
      {
        "scope": [
          "string", "string.quoted", "string.template", "string.unquoted",
          "constant.numeric", "constant.character",
          "constant.other.color", "constant.other.color.rgb-value", "constant.other.color.rgb-value.css"
        ],
        "settings": {
          "foreground": "#4a4a4a",
          "fontStyle": "italic"
        }
      },
      {
        "scope": [
          "comment", "punctuation.definition.comment", "string.quoted.docstring"
        ],
        "settings": {
          "foreground": "#a695d6",
          "fontStyle": "bold"
        }
      }
    ]
  },

  "editor.glyphMargin": false,
  "editor.showFoldingControls": "mouseover",
  "editor.occurrencesHighlight": "off",
  "editor.renderLineHighlight": "gutter",
  "editor.hideCursorInOverviewRuler": true,
  "editor.scrollbar.vertical": "auto",
  "editor.scrollbar.verticalScrollbarSize": 6,
  "editor.scrollbar.horizontalScrollbarSize": 6,

  "files.autoSave": "afterDelay",
  "editor.formatOnSave": true,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorBlinking": "smooth",
  "editor.smoothScrolling": true,
  "workbench.list.smoothScrolling": true,
  "terminal.integrated.smoothScrolling": true,

  "editor.lineHeight": 1.6,
  "editor.fontSize": 13,
  "editor.fontFamily": "'JetBrains Mono', 'SF Mono', Menlo, Monaco, monospace",
  "editor.fontLigatures": true,
  "editor.bracketPairColorization.enabled": true,

  "editor.inlineSuggest.enabled": true,
  "editor.inlineSuggest.showToolbar": "onHover",
  "editor.suggest.preview": true,

  "zenMode.hideLineNumbers": false,
  "zenMode.centerLayout": true,
  "zenMode.fullScreen": false,
  "zenMode.silentNotifications": true,

  "vscode_custom_css.imports": [
    "file:///Users/chamaththiwanka/.gemini/antigravity-ide/custom.css",
    "file:///Users/chamaththiwanka/.gemini/antigravity-ide/custom.js"
  ]
}